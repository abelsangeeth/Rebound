# Copy to .env . NEVER commit the real file.
DATABASE_URL=postgres://rebound:rebound@localhost:55432/rebound
REDIS_URL=redis://localhost:56379

# Razorpay TEST keys only. Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks -> the secret you typed when creating it
RAZORPAY_WEBHOOK_SECRET=

# Optional. Without it, nudge copy falls back to templates and the app still runs.
ANTHROPIC_API_KEY=

DECISION_URL=http://localhost:8000
PORT=3000
